<UserControl x:Class="Bronxamp.Prikaz.FolderiPrikaz"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:p="clr-namespace:Bronxamp.Prikaz"
             xmlns:vm="clr-namespace:Bronxamp.Vm">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TreeView x:Name="Stablo" ItemsSource="{Binding Koreni}" Background="Transparent" BorderThickness="0" Margin="0,0,12,0"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  Foreground="{StaticResource Tekst}" SelectedItemChanged="NaIzbor">
            <TreeView.ItemContainerStyle>
                <Style TargetType="TreeViewItem">
                    <Setter Property="Foreground" Value="{StaticResource Tekst}" />
                    <Setter Property="FontSize" Value="13" />
                    <Setter Property="Padding" Value="2,3" />
                </Style>
            </TreeView.ItemContainerStyle>
            <TreeView.ItemTemplate>
                <HierarchicalDataTemplate DataType="{x:Type vm:FolderCvor}" ItemsSource="{Binding Deca}">
                    <TextBlock Text="{Binding Naziv}" ToolTip="{Binding Putanja}" Foreground="{StaticResource Tekst}" />
                </HierarchicalDataTemplate>
            </TreeView.ItemTemplate>
        </TreeView>

        <p:PesmeLista Grid.Column="1" />
    </Grid>
</UserControl>
