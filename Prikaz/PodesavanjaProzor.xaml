<Window x:Class="Bronxamp.Prikaz.PodesavanjaProzor"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:p="clr-namespace:Bronxamp.Prikaz"
        Title="Podešavanja" Width="600" SizeToContent="Height" WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner" FontFamily="Segoe UI"
        Background="{StaticResource Panel}" BorderBrush="{StaticResource PovrsinaHover}" BorderThickness="1"
        MouseLeftButtonDown="NaPrevlacenje" KeyDown="NaTaster">
    <StackPanel Margin="26,22">
        <Grid>
            <TextBlock Text="Podešavanja" FontSize="21" FontWeight="SemiBold" Foreground="{StaticResource Tekst}" />
            <Button Style="{StaticResource DugmeZatvori}" Content="&#xE8BB;" Click="NaOtkazi" ToolTip="Zatvori"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-10,-14,0" />
        </Grid>

        <TextBlock Text="{p:Prevod JEZIK / LANGUAGE}" Style="{StaticResource NaslovSekcije}" Margin="0,20,0,8" />
        <ComboBox x:Name="Jezik" Style="{StaticResource PadajuciSpisak}" SelectionChanged="NaJezik">
            <ComboBoxItem Tag="sr" Content="Srpski" />
            <ComboBoxItem Tag="en" Content="English" />
        </ComboBox>

        <TextBlock Text="{p:Prevod FOLDERI SA MUZIKOM}" Style="{StaticResource NaslovSekcije}" Margin="0,20,0,8" />
        <ListBox x:Name="Folderi" Style="{StaticResource Lista}" MaxHeight="130" MinHeight="34" />
        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <Button Content="Dodaj folder" Style="{StaticResource Dugme}" Click="NaDodajFolder" Margin="0,0,8,0" />
            <Button Content="Ukloni" Style="{StaticResource Dugme}" Click="NaUkloniFolder" Margin="0,0,8,0" />
            <Button Content="Skeniraj ponovo" Style="{StaticResource Dugme}" Click="NaSkeniraj" Margin="0,0,8,0" />
            <Button x:Name="DugmeVrati" Style="{StaticResource Dugme}" Click="NaVratiAlbume" />
        </StackPanel>

        <TextBlock Text="PRELAZ IZMEĐU PESAMA" Style="{StaticResource NaslovSekcije}" Margin="0,22,0,8" />
        <DockPanel>
            <TextBlock x:Name="PrelazTekst" DockPanel.Dock="Right" Width="46" TextAlignment="Right" Foreground="{StaticResource Tekst}" FontSize="13" VerticalAlignment="Center" />
            <Slider x:Name="Prelaz" Style="{StaticResource Klizac}" Minimum="0" Maximum="5" TickFrequency="0.5" IsSnapToTickEnabled="True" ValueChanged="NaPrelaz" />
        </DockPanel>
        <CheckBox x:Name="PrelazUAlbumima" Content="Prelaz i kad svira album (inače album ide bez prekida i bez prelaza)" Margin="0,8,0,0" />

        <TextBlock Text="EMISIJE" Style="{StaticResource NaslovSekcije}" Margin="0,22,0,8" />
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="Upozori ako je pesma puštana u istoj emisiji u poslednjih" Foreground="{StaticResource Tekst}" FontSize="13" VerticalAlignment="Center" />
            <TextBox x:Name="Nedelja" Style="{StaticResource PoljeZaUnos}" Width="52" Margin="8,0" TextAlignment="Center" FontSize="13" Padding="4,5" />
            <TextBlock Text="nedelja" Foreground="{StaticResource Tekst}" FontSize="13" VerticalAlignment="Center" />
        </StackPanel>

        <TextBlock Text="ZVUK" Style="{StaticResource NaslovSekcije}" Margin="0,22,0,8" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
            </Grid.RowDefinitions>
            <TextBlock Text="Izlaz" Foreground="{StaticResource Tekst}" FontSize="13" VerticalAlignment="Center" />
            <ComboBox x:Name="Izlaz" Grid.Column="1" Style="{StaticResource PadajuciSpisak}" />
            <TextBlock Grid.Row="1" Text="Slušalice (preslušavanje)" Foreground="{StaticResource Tekst}" FontSize="13" VerticalAlignment="Center" Margin="0,8,0,0" />
            <ComboBox x:Name="Slusalice" Grid.Row="1" Grid.Column="1" Style="{StaticResource PadajuciSpisak}" Margin="0,8,0,0" />
        </Grid>


        <TextBlock Text="EMITOVANJE NA ZENO.FM" Style="{StaticResource NaslovSekcije}" Margin="0,22,0,8" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
            </Grid.RowDefinitions>
            <TextBlock Text="Adresa" Foreground="{StaticResource Tekst}" FontSize="13" VerticalAlignment="Center" />
            <TextBox x:Name="StreamServer" Grid.Column="1" Style="{StaticResource PoljeZaUnos}" FontSize="13" Padding="8,5" />
            <TextBlock Grid.Column="3" Text="Port" Foreground="{StaticResource Tekst}" FontSize="13" VerticalAlignment="Center" />
            <TextBox x:Name="StreamPort" Grid.Column="4" Style="{StaticResource PoljeZaUnos}" FontSize="13" Padding="8,5" />

            <TextBlock Grid.Row="1" Text="Mount" Foreground="{StaticResource Tekst}" FontSize="13" VerticalAlignment="Center" Margin="0,8,0,0" />
            <TextBox x:Name="StreamMount" Grid.Row="1" Grid.Column="1" Style="{StaticResource PoljeZaUnos}" FontSize="13" Padding="8,5" Margin="0,8,0,0" />
            <TextBlock Grid.Row="1" Grid.Column="3" Text="Korisnik" Foreground="{StaticResource Tekst}" FontSize="13" VerticalAlignment="Center" Margin="0,8,0,0" />
            <TextBox x:Name="StreamKorisnik" Grid.Row="1" Grid.Column="4" Style="{StaticResource PoljeZaUnos}" FontSize="13" Padding="8,5" Margin="0,8,0,0" />

            <TextBlock Grid.Row="2" Text="Lozinka" Foreground="{StaticResource Tekst}" FontSize="13" VerticalAlignment="Center" Margin="0,8,0,0" />
            <DockPanel Grid.Row="2" Grid.Column="1" Margin="0,8,0,0">
                <Button x:Name="DugmeLozinka" DockPanel.Dock="Right" Content="Prikaži" Style="{StaticResource Dugme}" Padding="9,4" FontSize="12" Margin="6,0,0,0" Click="NaPrikaziLozinku" />
                <Grid>
                    <Border Background="{StaticResource Povrsina}" CornerRadius="8" Padding="8,5">
                        <PasswordBox x:Name="LozinkaSkrivena" Background="Transparent" BorderThickness="0" Foreground="{StaticResource Tekst}" CaretBrush="{StaticResource Tekst}" FontSize="13" />
                    </Border>
                    <TextBox x:Name="LozinkaVidljiva" Style="{StaticResource PoljeZaUnos}" FontSize="13" Padding="8,5" Visibility="Collapsed" />
                </Grid>
            </DockPanel>
            <TextBlock Grid.Row="2" Grid.Column="3" Text="Kvalitet" Foreground="{StaticResource Tekst}" FontSize="13" VerticalAlignment="Center" Margin="0,8,0,0" />
            <DockPanel Grid.Row="2" Grid.Column="4" Margin="0,8,0,0">
                <ComboBox x:Name="StreamFormat" DockPanel.Dock="Left" Style="{StaticResource PadajuciSpisak}" Width="84" Margin="0,0,6,0" />
                <ComboBox x:Name="StreamKbps" Style="{StaticResource PadajuciSpisak}" />
            </DockPanel>
        </Grid>
        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
            <CheckBox x:Name="Probno" Content="Probno (lokalni Icecast 127.0.0.1:8000 — pravi Zeno se ne dira)" VerticalAlignment="Center" />
            <Button Content="Test veze" Style="{StaticResource Dugme}" Padding="10,4" FontSize="12" Margin="12,0,0,0" Click="NaTestVeze" />
        </StackPanel>
        <TextBlock Text="Lozinka je šifrovana za ovaj Windows nalog (DPAPI). Dok je uključeno „Probno“, emituje se na lokalni server, ne na pravi Zeno." Foreground="{StaticResource Mutan}" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap" />

        <DockPanel Margin="0,24,0,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Image Source="pack://application:,,,/Bronxamp;component/assets/logo_bronxsoft.png" Height="44" RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock x:Name="Verzija" Foreground="{StaticResource Bled}" FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Otkaži" Style="{StaticResource Dugme}" Click="NaOtkazi" MinWidth="90" Margin="0,0,8,0" />
                <Button Content="Sačuvaj" Style="{StaticResource DugmeGlavno}" Click="NaSacuvaj" MinWidth="90" IsDefault="True" />
            </StackPanel>
        </DockPanel>
    </StackPanel>
</Window>
