<UserControl x:Class="Bronxamp.Prikaz.ZidPrikaz"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:p="clr-namespace:Bronxamp.Prikaz"
             SizeChanged="NaPromenuVelicine" DataContextChanged="NaPromenuPodataka">
    <UserControl.Resources>
        <p:ImaUVidljivost x:Key="Ima" />
    </UserControl.Resources>
    <Grid>
        <TextBlock Text="{Binding Prazno}" Foreground="{StaticResource Mutan}" FontSize="16"
                   HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                   Visibility="{Binding Prazno, Converter={StaticResource Ima}}" />

        <ItemsControl x:Name="Redovi" ItemsSource="{Binding Redovi}"
                      VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                      VirtualizingPanel.ScrollUnit="Pixel" ScrollViewer.CanContentScroll="True">
            <ItemsControl.Template>
                <ControlTemplate TargetType="ItemsControl">
                    <ScrollViewer CanContentScroll="True" Focusable="False" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsPresenter />
                    </ScrollViewer>
                </ControlTemplate>
            </ItemsControl.Template>
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel>
                        <TextBlock Text="{Binding Zaglavlje}" Visibility="{Binding ZaglavljeVidljivo}"
                                   FontSize="19" FontWeight="SemiBold" Foreground="{StaticResource Tekst}" Margin="0,8,0,12" />
                        <ItemsControl ItemsSource="{Binding Kartice}" Visibility="{Binding KarticeVidljive}" Margin="0,0,0,18"
                                      Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel x:Name="Plocica" Width="{Binding DataContext.Velicina, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                Margin="0,0,18,0" Background="Transparent" Cursor="Hand"
                                                MouseLeftButtonUp="NaKlikPlocice" MouseRightButtonUp="NaDesniKlikPlocice">
                                        <Grid Height="{Binding DataContext.Velicina, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                                            <Border CornerRadius="10" Background="{Binding Preliv}">
                                                <TextBlock Text="{Binding IzvodjacVelika}" Foreground="#F0EDE6" FontWeight="Bold" FontSize="13"
                                                           TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="40"
                                                           VerticalAlignment="Bottom" Margin="10,0,10,10" />
                                            </Border>
                                            <Border x:Name="Slika" CornerRadius="10" Background="{Binding OmotCetka}" RenderOptions.BitmapScalingMode="HighQuality" />
                                            <Border x:Name="Alati" Visibility="Collapsed" VerticalAlignment="Bottom" CornerRadius="0,0,10,10" Background="#D0101014" Padding="3,4">
                                                <UniformGrid Rows="1">
                                                    <Button Style="{StaticResource DugmeAlat}" Content="&#xE768;" Tag="pusti" Click="NaAlat" ToolTip="Pusti album" />
                                                    <Button Style="{StaticResource DugmeAlat}" Content="&#xE893;" Tag="sledece" Click="NaAlat" ToolTip="Pusti sledeće (posle ove pesme)" />
                                                    <Button Style="{StaticResource DugmeAlat}" Content="&#xE710;" Tag="red" Click="NaAlat" ToolTip="Dodaj u red (na kraj)" />
                                                    <Button Style="{StaticResource DugmeAlat}" Content="&#xE8FD;" Tag="pesme" Click="NaAlat" ToolTip="Prikaži pesme" />
                                                    <Button Style="{StaticResource DugmeAlat}" Content="&#xE74D;" Tag="ukloni" Click="NaAlat" ToolTip="Ukloni iz biblioteke" />
                                                </UniformGrid>
                                            </Border>
                                        </Grid>
                                        <TextBlock Text="{Binding Naziv}" Foreground="{StaticResource Tekst}" FontSize="14"
                                                   Margin="0,7,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Naziv}" ToolTipService.InitialShowDelay="900" />
                                        <TextBlock Text="{Binding Izvodjac}" Foreground="{StaticResource Mutan}" FontSize="12"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <DataTemplate.Triggers>
                                        <Trigger SourceName="Plocica" Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Alati" Property="Visibility" Value="Visible" />
                                        </Trigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</UserControl>
