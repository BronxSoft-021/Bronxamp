<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Colors taken from dizajn/1_glavni_prozor.png -->
    <Color x:Key="BojaPozadina">#141419</Color>
    <Color x:Key="BojaPanel">#17171D</Color>
    <Color x:Key="BojaPovrsina">#22222B</Color>
    <Color x:Key="BojaPovrsinaHover">#2B2B36</Color>
    <Color x:Key="BojaLinija">#26262F</Color>
    <Color x:Key="BojaTekst">#EDEAE4</Color>
    <Color x:Key="BojaMutan">#A09C94</Color>
    <Color x:Key="BojaBled">#6E6B66</Color>
    <Color x:Key="BojaAkcenat">#E8763A</Color>
    <Color x:Key="BojaKrem">#EFEBE0</Color>
    <Color x:Key="BojaLcd">#0D1A16</Color>
    <Color x:Key="BojaLcdDuh">#1D2E28</Color>
    <Color x:Key="BojaUpozorenje">#E8B33A</Color>

    <SolidColorBrush x:Key="Pozadina" Color="{StaticResource BojaPozadina}" />
    <SolidColorBrush x:Key="Panel" Color="{StaticResource BojaPanel}" />
    <SolidColorBrush x:Key="Povrsina" Color="{StaticResource BojaPovrsina}" />
    <SolidColorBrush x:Key="PovrsinaHover" Color="{StaticResource BojaPovrsinaHover}" />
    <SolidColorBrush x:Key="Linija" Color="{StaticResource BojaLinija}" />
    <SolidColorBrush x:Key="Tekst" Color="{StaticResource BojaTekst}" />
    <SolidColorBrush x:Key="Mutan" Color="{StaticResource BojaMutan}" />
    <SolidColorBrush x:Key="Bled" Color="{StaticResource BojaBled}" />
    <SolidColorBrush x:Key="Akcenat" Color="{StaticResource BojaAkcenat}" />
    <SolidColorBrush x:Key="Krem" Color="{StaticResource BojaKrem}" />
    <SolidColorBrush x:Key="Lcd" Color="{StaticResource BojaLcd}" />
    <SolidColorBrush x:Key="LcdDuh" Color="{StaticResource BojaLcdDuh}" />
    <SolidColorBrush x:Key="Upozorenje" Color="{StaticResource BojaUpozorenje}" />

    <!-- Floor of the place where songs go in: black at the far (top) end, panel grey at the near end -->
    <LinearGradientBrush x:Key="DubinaPozadina" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#000000" Offset="0" />
        <GradientStop Color="#121218" Offset="0.55" />
        <GradientStop Color="#22222B" Offset="1" />
    </LinearGradientBrush>

    <FontFamily x:Key="Ikone">Segoe MDL2 Assets</FontFamily>
    <FontFamily x:Key="Lcd7">pack://application:,,,/Bronxamp;component/fonts/#DSEG7 Classic</FontFamily>
    <FontFamily x:Key="Lcd14">pack://application:,,,/Bronxamp;component/fonts/#DSEG14 Classic</FontFamily>

    <BooleanToVisibilityConverter x:Key="BoolUVidljivost" />

    <!-- ===== Text ===== -->
    <Style x:Key="NaslovSekcije" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Bled}" />
    </Style>

    <Style x:Key="NaslovStrane" TargetType="TextBlock">
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Tekst}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- ===== Buttons ===== -->
    <Style x:Key="OkruglaDugmad" TargetType="Button">
        <Setter Property="Width" Value="46" />
        <Setter Property="Height" Value="46" />
        <Setter Property="Background" Value="#33000000" />
        <Setter Property="Foreground" Value="{StaticResource Tekst}" />
        <Setter Property="FontFamily" Value="{StaticResource Ikone}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Krug" Background="{TemplateBinding Background}" CornerRadius="100">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Krug" Property="Background" Value="#55000000" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Krug" Property="Opacity" Value="0.7" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Krug" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GlavnoDugme" TargetType="Button" BasedOn="{StaticResource OkruglaDugmad}">
        <Setter Property="Width" Value="62" />
        <Setter Property="Height" Value="62" />
        <Setter Property="Background" Value="{StaticResource Krem}" />
        <Setter Property="Foreground" Value="#17171D" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Krug" Background="{TemplateBinding Background}" CornerRadius="100">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Krug" Property="Background" Value="#FFFFFF" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Krug" Property="Opacity" Value="0.8" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Small action buttons that appear over a tile or row under the mouse -->
    <Style x:Key="DugmeAlat" TargetType="Button">
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource Tekst}" />
        <Setter Property="FontFamily" Value="{StaticResource Ikone}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Krug" Background="{TemplateBinding Background}" CornerRadius="100">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Krug" Property="Background" Value="#55FFFFFF" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Krug" Property="Opacity" Value="0.7" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DugmeProzora" TargetType="Button">
        <Setter Property="Width" Value="42" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource Tekst}" />
        <Setter Property="FontFamily" Value="{StaticResource Ikone}" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Pozadina" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Pozadina" Property="Background" Value="#33FFFFFF" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DugmeZatvori" TargetType="Button" BasedOn="{StaticResource DugmeProzora}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Pozadina" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Pozadina" Property="Background" Value="#C42B1C" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Dugme" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource Povrsina}" />
        <Setter Property="Foreground" Value="{StaticResource Tekst}" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Pozadina" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Pozadina" Property="Background" Value="{StaticResource PovrsinaHover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Pozadina" Property="Opacity" Value="0.8" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Pozadina" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DugmeGlavno" TargetType="Button" BasedOn="{StaticResource Dugme}">
        <Setter Property="Background" Value="{StaticResource Akcenat}" />
        <Setter Property="Foreground" Value="#1B1206" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Pozadina" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Pozadina" Property="Opacity" Value="0.88" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Pozadina" Property="Opacity" Value="0.75" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Pozadina" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Quiet action inside the connection bar in the status row -->
    <Style x:Key="DugmeVeze" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource Akcenat}" />
        <Setter Property="Padding" Value="10,3" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Pozadina" Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Pozadina" Property="Background" Value="{StaticResource PovrsinaHover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Pozadina" Property="Opacity" Value="0.75" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Pozadina" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Left menu entry -->
    <Style x:Key="StavkaMenija" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource Tekst}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Pozadina" Background="{TemplateBinding Background}" CornerRadius="7" Padding="10,7" Margin="0,1">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Pozadina" Property="Background" Value="#1F1F27" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Omoti / Lista / A-Š / Godina -->
    <!-- Parts of a page, above it. The data is a NavStavka. -->
    <Style x:Key="Pilula" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource Mutan}" />
        <Setter Property="Background" Value="{StaticResource Povrsina}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="14" Padding="14,6">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{StaticResource Tekst}" />
                <Setter Property="Background" Value="{StaticResource PovrsinaHover}" />
            </Trigger>
            <DataTrigger Binding="{Binding Aktivna}" Value="True">
                <Setter Property="Foreground" Value="{StaticResource Tekst}" />
                <Setter Property="Background" Value="{StaticResource PovrsinaHover}" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="TabPrikaza" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource Mutan}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Margin" Value="16,0,0,0" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <StackPanel Background="Transparent">
                        <ContentPresenter />
                        <Border x:Name="Crta" Height="2" Margin="0,5,0,0" Background="{StaticResource Akcenat}" Visibility="Hidden" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Crta" Property="Visibility" Value="Visible" />
                            <Setter Property="Foreground" Value="{StaticResource Tekst}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource Tekst}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Input ===== -->
    <Style x:Key="PoljeZaUnos" TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource Povrsina}" />
        <Setter Property="Foreground" Value="{StaticResource Tekst}" />
        <Setter Property="CaretBrush" Value="{StaticResource Tekst}" />
        <Setter Property="SelectionBrush" Value="{StaticResource Akcenat}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border Background="{TemplateBinding Background}" CornerRadius="8">
                        <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource Tekst}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="Kutija" Width="18" Height="18" CornerRadius="4" Background="{StaticResource Povrsina}" VerticalAlignment="Center">
                            <TextBlock x:Name="Kvacica" Text="&#xE73E;" FontFamily="{StaticResource Ikone}" FontSize="11" Foreground="#1B1206"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Hidden" />
                        </Border>
                        <ContentPresenter Margin="9,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Kutija" Property="Background" Value="{StaticResource Akcenat}" />
                            <Setter TargetName="Kvacica" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Slider -->
    <Style x:Key="PraznoDugmeKlizaca" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Klizac" TargetType="Slider">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsMoveToPointEnabled" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid Background="Transparent" MinHeight="20">
                        <Border Height="4" CornerRadius="2" Background="#55FFFFFF" VerticalAlignment="Center" />
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Grid Background="Transparent">
                                                <Border Height="4" CornerRadius="2" Background="{StaticResource Krem}" VerticalAlignment="Center" />
                                            </Grid>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource PraznoDugmeKlizaca}" />
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Width="12" Height="12">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Ellipse Fill="{StaticResource Krem}" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Scroll bar -->
    <Style x:Key="PalacTrake" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="Palac" Background="#3A3A46" CornerRadius="4" Margin="2" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Palac" Property="Background" Value="#55555F" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Palac" Property="Background" Value="#6B6B76" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="11" />
        <Setter Property="MinWidth" Value="11" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource PraznoDugmeKlizaca}" />
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource PraznoDugmeKlizaca}" />
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource PalacTrake}" />
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Height" Value="11" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="Transparent">
                                <Track x:Name="PART_Track">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageLeftCommand" Style="{StaticResource PraznoDugmeKlizaca}" />
                                    </Track.DecreaseRepeatButton>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageRightCommand" Style="{StaticResource PraznoDugmeKlizaca}" />
                                    </Track.IncreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource PalacTrake}" />
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ListBox rows -->
    <Style x:Key="RedListe" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{StaticResource Tekst}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Pozadina" Background="{TemplateBinding Background}" CornerRadius="6" Padding="10,0">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Pozadina" Property="Background" Value="#1F1F27" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Pozadina" Property="Background" Value="#2B2B36" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Lista" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource Tekst}" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource RedListe}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
        <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel" />
    </Style>

    <!-- Song list with columns: tight rows, the header is drawn by the GridView -->
    <Style x:Key="RedKolona" TargetType="ListViewItem">
        <Setter Property="Foreground" Value="{StaticResource Tekst}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListViewItem">
                    <Border x:Name="Pozadina" Background="{TemplateBinding Background}" CornerRadius="4">
                        <GridViewRowPresenter Columns="{TemplateBinding GridView.ColumnCollection}" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Pozadina" Property="Background" Value="#1F1F27" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Pozadina" Property="Background" Value="#2B2B36" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- WPF's own version of this draws two white lines in the corner between the scroll bars -->
    <Style x:Key="SkrolKolona" TargetType="ScrollViewer">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollViewer">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <DockPanel>
                            <ScrollViewer DockPanel.Dock="Top" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden">
                                <GridViewHeaderRowPresenter
                                    Columns="{Binding TemplatedParent.View.Columns, RelativeSource={RelativeSource TemplatedParent}}"
                                    ColumnHeaderContainerStyle="{Binding TemplatedParent.View.ColumnHeaderContainerStyle, RelativeSource={RelativeSource TemplatedParent}}"
                                    AllowsColumnReorder="{Binding TemplatedParent.View.AllowsColumnReorder, RelativeSource={RelativeSource TemplatedParent}}" />
                            </ScrollViewer>
                            <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" KeyboardNavigation.DirectionalNavigation="Local"
                                                    CanContentScroll="{TemplateBinding CanContentScroll}" />
                        </DockPanel>
                        <ScrollBar x:Name="PART_HorizontalScrollBar" Grid.Row="1" Orientation="Horizontal" Minimum="0"
                                   Maximum="{TemplateBinding ScrollableWidth}" ViewportSize="{TemplateBinding ViewportWidth}"
                                   Value="{TemplateBinding HorizontalOffset}" Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}" />
                        <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Column="1" Orientation="Vertical" Minimum="0"
                                   Maximum="{TemplateBinding ScrollableHeight}" ViewportSize="{TemplateBinding ViewportHeight}"
                                   Value="{TemplateBinding VerticalOffset}" Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ListaKolona" TargetType="ListView">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource Tekst}" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource RedKolona}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
        <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListView">
                    <ScrollViewer Style="{StaticResource SkrolKolona}">
                        <ItemsPresenter />
                    </ScrollViewer>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ZaglavljeKolone" TargetType="GridViewColumnHeader">
        <Setter Property="Foreground" Value="{StaticResource Mutan}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Height" Value="28" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="ToolTip" Value="Prevuci kolonu da je pomeriš. Desni klik: izaberi šta se vidi u spisku." />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GridViewColumnHeader">
                    <Grid Background="Transparent">
                        <Border BorderBrush="{StaticResource Linija}" BorderThickness="0,0,0,1" />
                        <ContentPresenter Margin="6,0" VerticalAlignment="Center" RecognizesAccessKey="False"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                        <Thumb x:Name="PART_HeaderGripper" HorizontalAlignment="Right" Width="9" Margin="0,0,-4,0" Cursor="SizeWE">
                            <Thumb.Template>
                                <ControlTemplate TargetType="Thumb">
                                    <Border Background="Transparent">
                                        <Border Width="1" Margin="0,7" Background="{StaticResource Linija}" />
                                    </Border>
                                </ControlTemplate>
                            </Thumb.Template>
                        </Thumb>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Role" Value="Floating">
                <Setter Property="ToolTip" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="GridViewColumnHeader">
                            <Canvas x:Name="PART_FloatingHeaderCanvas" Opacity="0.7" />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ZaglavljeDesno" TargetType="GridViewColumnHeader" BasedOn="{StaticResource ZaglavljeKolone}">
        <Setter Property="HorizontalContentAlignment" Value="Right" />
    </Style>

    <Style x:Key="DugmeDole" TargetType="Button" BasedOn="{StaticResource OkruglaDugmad}">
        <Setter Property="Width" Value="38" />
        <Setter Property="Height" Value="38" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Margin" Value="0,0,5,0" />
    </Style>

    <!-- Dark context menu -->
    <Style TargetType="ContextMenu">
        <Setter Property="Foreground" Value="{StaticResource Tekst}" />
        <Setter Property="HasDropShadow" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="#22222B" BorderBrush="#34343F" BorderThickness="1" CornerRadius="8" Padding="4">
                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Menus look separators up under this key, not by type. -->
    <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Height="1" Background="#34343F" Margin="8,4" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="MenuItem">
        <Setter Property="Foreground" Value="{StaticResource Tekst}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Grid>
                        <Border x:Name="Pozadina" Background="Transparent" CornerRadius="5" Padding="12,6,10,6" MinWidth="190">
                            <DockPanel>
                                <TextBlock x:Name="Kvacica" DockPanel.Dock="Left" Text="&#xE73E;" FontFamily="{StaticResource Ikone}" FontSize="11" Width="22"
                                           Foreground="{StaticResource Akcenat}" VerticalAlignment="Center" Visibility="Collapsed" />
                                <TextBlock x:Name="Strelica" DockPanel.Dock="Right" Text="&#xE76C;" FontFamily="{StaticResource Ikone}"
                                           FontSize="9" VerticalAlignment="Center" Margin="16,0,0,0" Visibility="Collapsed" />
                                <ContentPresenter ContentSource="Header" RecognizesAccessKey="False" VerticalAlignment="Center" />
                            </DockPanel>
                        </Border>
                        <Popup x:Name="PART_Popup" Placement="Right" IsOpen="{TemplateBinding IsSubmenuOpen}"
                               AllowsTransparency="True" Focusable="False" PopupAnimation="None">
                            <Border Background="#22222B" BorderBrush="#34343F" BorderThickness="1" CornerRadius="8" Padding="4">
                                <ScrollViewer MaxHeight="420" VerticalScrollBarVisibility="Auto">
                                    <StackPanel IsItemsHost="True" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Role" Value="SubmenuHeader">
                            <Setter TargetName="Strelica" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsCheckable" Value="True">
                            <Setter TargetName="Kvacica" Property="Visibility" Value="Hidden" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Kvacica" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Pozadina" Property="Background" Value="#34343F" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource Bled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ToolTip">
        <Setter Property="Foreground" Value="{StaticResource Tekst}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="#22222B" BorderBrush="#34343F" BorderThickness="1" CornerRadius="6" Padding="9,5">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ComboBox -->
    <Style x:Key="PadajuciSpisak" TargetType="ComboBox">
        <Setter Property="Foreground" Value="{StaticResource Tekst}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Pozadina" Background="{StaticResource Povrsina}" CornerRadius="8">
                                        <TextBlock Text="&#xE70D;" FontFamily="{StaticResource Ikone}" FontSize="10" Foreground="{StaticResource Mutan}"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,11,0" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Pozadina" Property="Background" Value="{StaticResource PovrsinaHover}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          IsHitTestVisible="False" Margin="12,8,30,8" VerticalAlignment="Center" HorizontalAlignment="Left" />
                        <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="None">
                            <Border Background="#22222B" BorderBrush="#34343F" BorderThickness="1" CornerRadius="8" Padding="4"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="280">
                                <ScrollViewer>
                                    <StackPanel IsItemsHost="True" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ComboBoxItem">
                    <Setter Property="Foreground" Value="{StaticResource Tekst}" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ComboBoxItem">
                                <Border x:Name="Pozadina" Background="Transparent" CornerRadius="5" Padding="10,6">
                                    <ContentPresenter />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsHighlighted" Value="True">
                                        <Setter TargetName="Pozadina" Property="Background" Value="#34343F" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
