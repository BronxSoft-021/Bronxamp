<Window x:Class="Bronxamp.Prikaz.GlavniProzor"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:p="clr-namespace:Bronxamp.Prikaz"
        xmlns:vm="clr-namespace:Bronxamp.Vm"
        Title="BronxSoft Bronxamp" MinWidth="1060" MinHeight="620" FontFamily="Segoe UI"
        Background="{StaticResource Pozadina}" Foreground="{StaticResource Tekst}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal"
        AllowDrop="True" DragOver="NaPrevlacenjeFajlova" DragLeave="NaNapustanjeFajlova" Drop="NaSpustanjeFajlova">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <p:HexUBoju x:Key="Boja" />
        <p:ImaUVidljivost x:Key="Ima" />
        <p:JednakoUBool x:Key="Jednako" />
        <BooleanToVisibilityConverter x:Key="BoolUVidljivost" />

        <DataTemplate DataType="{x:Type vm:ZidStrana}">
            <p:ZidPrikaz />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:FolderiStrana}">
            <p:FolderiPrikaz />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:EmitovanoStrana}">
            <p:EmitovanoPrikaz />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DanStrana}">
            <p:DanPrikaz />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PesmeStrana}">
            <p:PesmeLista />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:StatistikaStrana}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <RadioButton Content="Ove nedelje" Style="{StaticResource TabPrikaza}" Margin="0,0,16,0" IsChecked="True" />
                    <RadioButton Content="Ovog meseca" Style="{StaticResource TabPrikaza}" Margin="0" IsChecked="{Binding Mesec}" />
                </StackPanel>
                <p:PesmeLista Grid.Row="1" />
            </Grid>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:EmisijaStrana}">
            <p:EmisijaPrikaz />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:IzvodjaciStrana}">
            <ListBox Style="{StaticResource Lista}" ItemsSource="{Binding Stavke}" MouseDoubleClick="NaIzvodjac" MouseLeftButtonUp="NaIzvodjac">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <DockPanel Height="36">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding Opis}" Foreground="{StaticResource Mutan}" FontSize="13" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Ime}" FontSize="15" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DataTemplate>

        <!-- Left menu entry: dot for shows, icon for the rest -->
        <DataTemplate x:Key="StavkaNav">
            <Button x:Name="Dugme" Style="{StaticResource StavkaMenija}" Command="{Binding OtvoriCommand}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Ikona}" FontFamily="{StaticResource Ikone}" FontSize="14" Width="26" VerticalAlignment="Center"
                               Visibility="{Binding Ikona, Converter={StaticResource Ima}}" />
                    <Ellipse Width="10" Height="10" Margin="2,0,14,0" VerticalAlignment="Center"
                             Fill="{Binding Boja, Converter={StaticResource Boja}}"
                             Visibility="{Binding Boja, Converter={StaticResource Ima}}" />
                    <TextBlock Text="{Binding Naziv}" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="150" />
                </StackPanel>
            </Button>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Aktivna}" Value="True">
                    <Setter TargetName="Dugme" Property="Background" Value="#2B2B36" />
                    <Setter TargetName="Dugme" Property="Foreground" Value="{StaticResource Tekst}" />
                    <Setter TargetName="Dugme" Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:EmisijeStrana}">
            <DockPanel>
                <Button x:Name="DugmeNovaEmisija" DockPanel.Dock="Top" Content="+ Nova emisija" Style="{StaticResource Dugme}" Padding="12,6" Margin="0,0,0,12"
                        HorizontalAlignment="Left" Click="NaNovaEmisija" />
                <TextBlock DockPanel.Dock="Top" Text="{Binding Prazno}" Foreground="{StaticResource Mutan}" FontSize="14"
                           Visibility="{Binding Prazno, Converter={StaticResource Ima}}" />
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Emisije}" ItemTemplate="{StaticResource StavkaNav}" />
                </ScrollViewer>
            </DockPanel>
        </DataTemplate>

        <!-- Taskbar thumbnail icons -->
        <DrawingImage x:Key="IkonaPrethodna">
            <DrawingImage.Drawing>
                <GeometryDrawing Brush="White" Geometry="M3,3 H5 V13 H3 Z M14,3 V13 L6,8 Z" />
            </DrawingImage.Drawing>
        </DrawingImage>
        <DrawingImage x:Key="IkonaPusti">
            <DrawingImage.Drawing>
                <GeometryDrawing Brush="White" Geometry="M4,2 L14,8 L4,14 Z" />
            </DrawingImage.Drawing>
        </DrawingImage>
        <DrawingImage x:Key="IkonaPauza">
            <DrawingImage.Drawing>
                <GeometryDrawing Brush="White" Geometry="M3,2 H7 V14 H3 Z M9,2 H13 V14 H9 Z" />
            </DrawingImage.Drawing>
        </DrawingImage>
        <DrawingImage x:Key="IkonaSledeca">
            <DrawingImage.Drawing>
                <GeometryDrawing Brush="White" Geometry="M2,3 V13 L10,8 Z M11,3 H13 V13 H11 Z" />
            </DrawingImage.Drawing>
        </DrawingImage>
    </Window.Resources>

    <Window.TaskbarItemInfo>
        <TaskbarItemInfo x:Name="Taskbar">
            <TaskbarItemInfo.ThumbButtonInfos>
                <ThumbButtonInfo Description="Prethodna" ImageSource="{StaticResource IkonaPrethodna}" Command="{Binding Plejer.PrethodnaCommand}" />
                <ThumbButtonInfo x:Name="ThumbPusti" Description="Pusti" ImageSource="{StaticResource IkonaPusti}" Command="{Binding Plejer.PustiPauzaCommand}" />
                <ThumbButtonInfo Description="Sledeća" ImageSource="{StaticResource IkonaSledeca}" Command="{Binding Plejer.SledecaCommand}" />
            </TaskbarItemInfo.ThumbButtonInfos>
        </TaskbarItemInfo>
    </Window.TaskbarItemInfo>

    <Grid x:Name="Koren" Background="{StaticResource Pozadina}">
        <Grid.RowDefinitions>
            <RowDefinition Height="28" />
            <RowDefinition Height="104" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="34" />
        </Grid.RowDefinitions>

        <!-- ===== State strip ===== -->
        <Grid x:Name="TrakaStanja" Background="{Binding Dan.BojaStanja}" MouseLeftButtonDown="NaPrevlacenjeProzora">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                <TextBlock Text="&#xEC05;" FontFamily="{StaticResource Ikone}" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBlock x:Name="NatpisStanja" Text="{Binding Dan.NatpisStanja}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Dan.OpisStanja}" FontSize="13" Margin="12,0,0,0" VerticalAlignment="Center" Opacity="0.85" />
            </StackPanel>
            <TextBlock Grid.Column="1" Text="{Binding Plejer.DatumTekst}" FontSize="13" VerticalAlignment="Center" Margin="0,0,14,0" />
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button Style="{StaticResource DugmeProzora}" Content="&#xE921;" Click="NaUmanji" ToolTip="Umanji" />
                <Button x:Name="DugmeUvecaj" Style="{StaticResource DugmeProzora}" Content="&#xE922;" Click="NaUvecaj" ToolTip="Uvećaj" />
                <Button Style="{StaticResource DugmeZatvori}" Content="&#xE8BB;" Click="NaZatvori" ToolTip="Zatvori" />
            </StackPanel>
        </Grid>

        <!-- ===== Clock, on air, next: one bar, tinted by the cover ===== -->
        <Border x:Name="GornjaTraka" Grid.Row="1" Margin="12,9,12,9" CornerRadius="12" ClipToBounds="True"
                BorderBrush="#26FFFFFF" BorderThickness="1" MouseLeftButtonDown="NaPrevlacenjeProzora">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop x:Name="BojaLevo" Offset="0" Color="#2A262E" />
                    <GradientStop x:Name="BojaSredina" Offset="0.55" Color="#2A262E" />
                    <GradientStop Offset="1" Color="#1A1A21" />
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>

                <Border Background="{StaticResource Lcd}" CornerRadius="8" Padding="12,5" VerticalAlignment="Center" Margin="10,0" MinWidth="158">
                    <StackPanel>
                        <p:LcdTekst Tekst="{Binding Plejer.SatTekst}" Velicina="24" HorizontalAlignment="Center" />
                        <p:LcdTekst Tekst="{Binding Plejer.PreostaloTekst}" Velicina="17" HorizontalAlignment="Center" Margin="0,4,0,0" ToolTip="Koliko još traje" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Background="#1FFFFFFF" Margin="0,12" />
                <Border x:Name="NaEtru" Grid.Column="2" Background="Transparent" ClipToBounds="True"
                        ToolTip="{Binding Plejer.NaEtruOpis}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="12" />
                        </Grid.RowDefinitions>

                        <p:Prah Grid.RowSpan="2" Aktivan="{Binding Plejer.Svira}" Opacity="0.6" />

                        <!-- spektar po hercima (20 Hz - 20 kHz, tercama), preko cele trake iza naslova;
                             oznake frekvencija samo dok svira, da prazna traka ne liči na pokvaren lenjir -->
                        <p:Spektar x:Name="SpektarTrake" Margin="8,6,8,0" Opacity="0.55" BrojStubica="31" Oznake="{Binding Plejer.Svira}"
                                   Aktivan="{Binding Plejer.Svira}" Boja="#3FAF6D" BojaVrha="#E8B33A" />

                        <!-- naslov i izvođač tačno po sredini, sa senkom da se čitaju preko spektra -->
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="112,0,112,4">
                            <StackPanel.Effect>
                                <DropShadowEffect BlurRadius="8" ShadowDepth="0" Color="Black" Opacity="0.9" />
                            </StackPanel.Effect>
                            <TextBlock Text="{Binding Plejer.NaEtruPesma}" FontSize="18" FontWeight="SemiBold"
                                       Foreground="{StaticResource Tekst}" TextTrimming="CharacterEllipsis"
                                       TextAlignment="Center" HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding Plejer.NaEtruIzvodjac}" FontSize="12.5"
                                       Foreground="{StaticResource Krem}" TextTrimming="CharacterEllipsis"
                                       TextAlignment="Center" HorizontalAlignment="Center" Margin="0,1,0,0" />
                        </StackPanel>

                        <!-- proteklo levo, preostalo desno, na LCD podlozi -->
                        <Border HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,4"
                                Background="{StaticResource Lcd}" CornerRadius="5" Padding="8,4" ToolTip="Proteklo">
                            <p:LcdTekst Tekst="{Binding Plejer.VremeTekst}" Velicina="20" Boja="#F0A23B" />
                        </Border>
                        <Border HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,4"
                                Background="{StaticResource Lcd}" CornerRadius="5" Padding="8,4" ToolTip="Preostalo">
                            <p:LcdTekst Tekst="{Binding Plejer.PreostaloTekst}" Velicina="20" Boja="#FFD27A" />
                        </Border>

                        <p:TrakaNapretka Grid.Row="1" x:Name="Napredak" Height="10" VisinaLinije="4" VerticalAlignment="Center"
                                         Margin="8,0,8,0" Odnos="{Binding Plejer.Odnos}" SamoDesniKlik="{Binding Dan.Aktivan}"
                                         ToolTip="Desni klik: skoči na to mesto u pesmi" />
                    </Grid>
                </Border>

                <Border Grid.Column="3" Background="#1FFFFFFF" Margin="0,12" />

                <Border x:Name="KarticaSledi" Grid.Column="4" Background="Transparent" Padding="16,6">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Plejer.KarticaSledi}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Plejer.KarticaSlediVreme}" FontSize="12.5" Opacity="0.8" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Dan.KarticaZadatoVreme}" FontSize="12.5" Opacity="0.8" TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding Dan.KarticaZadato, Converter={StaticResource Ima}}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="330" />
            </Grid.ColumnDefinitions>

            <!-- ===== Left menu ===== -->
            <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Linija}" BorderThickness="0,0,1,0">
                <DockPanel Margin="18,22,18,12">
                    <StackPanel DockPanel.Dock="Bottom">
                        <TextBlock Text="{Binding StatusSkeniranja}" Foreground="{StaticResource Mutan}" FontSize="12" Margin="10,0,0,8"
                                   Visibility="{Binding StatusSkeniranja, Converter={StaticResource Ima}}" />
                        <Border BorderBrush="{StaticResource Linija}" BorderThickness="0,1,0,0" Padding="0,8,0,0">
                            <StackPanel>
                                <Button Style="{StaticResource StavkaMenija}" Click="NaPodesavanja">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE713;" FontFamily="{StaticResource Ikone}" FontSize="14" Width="26" VerticalAlignment="Center" />
                                        <TextBlock Text="Podešavanja" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <StackPanel Orientation="Horizontal" Margin="6,4,0,0">
                                    <Button x:Name="DugmePomoc" Style="{StaticResource DugmeAlat}" Width="34" Height="34" FontSize="14" Margin="0,0,6,0"
                                            Content="&#xE897;" Click="NaPomoc" ToolTip="Pomoć (F1)" />
                                    <Button x:Name="DugmeOProgramu" Style="{StaticResource DugmeAlat}" Width="34" Height="34" FontSize="14"
                                            Content="&#xE946;" Click="NaOProgramu" ToolTip="O programu" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <ScrollViewer x:Name="MeniSkrol" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="P R O G R A M" Style="{StaticResource NaslovSekcije}" Margin="0,0,0,8" />
                            <ItemsControl ItemsSource="{Binding NavProgram}" ItemTemplate="{StaticResource StavkaNav}" />

                            <TextBlock Text="M U Z I K A" Style="{StaticResource NaslovSekcije}" Margin="0,20,0,8" />
                            <ItemsControl ItemsSource="{Binding NavMuzika}" ItemTemplate="{StaticResource StavkaNav}" />

                            <TextBlock Text="I Z V E Š T A J" Style="{StaticResource NaslovSekcije}" Margin="0,20,0,8" />
                            <ItemsControl ItemsSource="{Binding NavIzvestaj}" ItemTemplate="{StaticResource StavkaNav}" />
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- ===== Middle ===== -->
            <Grid Grid.Column="1" Margin="24,20,16,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <DockPanel Margin="0,0,8,16">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"
                                Visibility="{Binding PrikaziTabove, Converter={StaticResource Ima}}">
                        <RadioButton Content="Omoti" Style="{StaticResource TabPrikaza}" IsChecked="{Binding Prikaz, Converter={StaticResource Jednako}, ConverterParameter=Omoti}" />
                        <RadioButton Content="Lista" Style="{StaticResource TabPrikaza}" IsChecked="{Binding Prikaz, Converter={StaticResource Jednako}, ConverterParameter=Lista}" />
                        <RadioButton Content="A-Š" Style="{StaticResource TabPrikaza}" IsChecked="{Binding Prikaz, Converter={StaticResource Jednako}, ConverterParameter=AS}" />
                        <RadioButton Content="Godina" Style="{StaticResource TabPrikaza}" IsChecked="{Binding Prikaz, Converter={StaticResource Jednako}, ConverterParameter=Godina}" />
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,6,0">
                        <Button x:Name="DugmeDodajAlbum" Content="+ Dodaj album" Style="{StaticResource DugmeGlavno}" Padding="12,6" Margin="0,0,8,0" Click="NaDodajAlbum"
                                ToolTip="Izaberi folder sa albumom. Muzika se može i prevući u prozor." />
                        <Button x:Name="DugmeDodajPesme" Content="+ Dodaj pesme" Style="{StaticResource Dugme}" Padding="12,6" Click="NaDodajPesme"
                                ToolTip="Izaberi jednu ili više pesama. Muzika se može i prevući u prozor." />
                    </StackPanel>
                    <Grid MaxWidth="420" HorizontalAlignment="Left">
                        <TextBox x:Name="Pretraga" Style="{StaticResource PoljeZaUnos}" Text="{Binding Upit, UpdateSourceTrigger=PropertyChanged}" Padding="30,8,10,8" />
                        <TextBlock Text="&#xE721;" FontFamily="{StaticResource Ikone}" FontSize="13" Foreground="{StaticResource Bled}"
                                   VerticalAlignment="Center" Margin="11,0,0,0" IsHitTestVisible="False" />
                        <TextBlock Text="Pretraži: &quot;ekv 1983&quot;, &quot;metal 90-e&quot;..." Foreground="{StaticResource Bled}" FontSize="14"
                                   VerticalAlignment="Center" Margin="32,0,0,0" IsHitTestVisible="False"
                                   Visibility="{Binding Upit, Converter={StaticResource Ima}, ConverterParameter=obrnuto}" />
                    </Grid>
                </DockPanel>

                <StackPanel Grid.Row="1">
                <!-- Parts of this page -->
                <DockPanel x:Name="RedPilula" Margin="0,0,8,14" Visibility="{Binding Pilule, Converter={StaticResource Ima}}">
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Strana.Podnaslov}" Foreground="{StaticResource Mutan}" FontSize="13" VerticalAlignment="Center"
                               Margin="12,0,0,0" Visibility="{Binding Strana.Nazad, Converter={StaticResource Ima}, ConverterParameter=obrnuto}" />
                    <ItemsControl ItemsSource="{Binding Pilule}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource Pilula}" Content="{Binding Naziv}" Command="{Binding OtvoriCommand}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>

                <!-- Page heading -->
                <DockPanel Margin="0,0,0,14" Visibility="{Binding Strana.Naslov, Converter={StaticResource Ima}}">
                    <Button DockPanel.Dock="Left" Content="&#xE72B;" Style="{StaticResource Dugme}" FontFamily="{StaticResource Ikone}" Padding="10,8"
                            Margin="0,0,12,0" Command="{Binding NazadCommand}" Visibility="{Binding Strana.Nazad, Converter={StaticResource Ima}}" ToolTip="Nazad" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Strana.Naslov}" Style="{StaticResource NaslovStrane}" />
                        <TextBlock Text="{Binding Strana.Podnaslov}" Foreground="{StaticResource Mutan}" FontSize="13"
                                   Visibility="{Binding Strana.Podnaslov, Converter={StaticResource Ima}}" />
                    </StackPanel>
                </DockPanel>
                </StackPanel>

                <ContentControl Grid.Row="2" Content="{Binding Strana}" Focusable="False" />

                <Button Grid.Row="2" Content="Dodaj folder sa muzikom" Style="{StaticResource DugmeGlavno}" Click="NaDodajAlbum"
                        HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,90,0,0" Padding="20,10"
                        Visibility="{Binding NemaFoldera, Converter={StaticResource Ima}}" />

                <!-- Headphones cue -->
                <Border Grid.Row="3" Background="{StaticResource Povrsina}" CornerRadius="8" Padding="12,7" Margin="0,10,8,0"
                        Visibility="{Binding Plejer.PreslusaNaslov, Converter={StaticResource Ima}}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Zaustavi" Style="{StaticResource Dugme}" Padding="10,4" Command="{Binding Plejer.ZaustaviPreslusavanjeCommand}" />
                        <TextBlock DockPanel.Dock="Right" Text="{Binding Plejer.PreslusaVreme}" Foreground="{StaticResource Mutan}" FontSize="12" VerticalAlignment="Center" Margin="10,0" />
                        <TextBlock FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                            <Run Text="&#xE7F6;" FontFamily="{StaticResource Ikone}" Foreground="{StaticResource Akcenat}" />
                            <Run Text="  Slušalice:" Foreground="{StaticResource Mutan}" />
                            <Run Text="{Binding Plejer.PreslusaNaslov, Mode=OneWay}" />
                        </TextBlock>
                    </DockPanel>
                </Border>

                <!-- Message: a quiet chip, not a banner across the screen -->
                <Border Grid.Row="3" Background="#1C1914" BorderBrush="{StaticResource Upozorenje}" BorderThickness="2,0,0,0" CornerRadius="6" Padding="10,7"
                        Margin="0,10,8,0" HorizontalAlignment="Left" MaxWidth="640" Visibility="{Binding Poruka, Converter={StaticResource Ima}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource Ikone}" FontSize="12" Foreground="{StaticResource Upozorenje}"
                                   VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="{Binding Poruka}" FontSize="13" TextWrapping="Wrap" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ===== Right panel ===== -->
            <Border Grid.Column="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource Linija}" BorderThickness="1,0,0,0">
                <DockPanel Margin="18,22,18,18">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Visibility="{Binding Plejer.ImaRed, Converter={StaticResource Ima}}">
                            <Button Content="Sačuvaj kao emisiju" Style="{StaticResource Dugme}" Padding="10,4" FontSize="11.5" Margin="0,0,6,0" Click="NaSacuvajRed" />
                            <Button Content="Isprazni" Style="{StaticResource Dugme}" Padding="10,4" FontSize="11.5" Click="NaIsprazniRed" />
                        </StackPanel>
                        <TextBlock Text="{Binding Plejer.SlediNaslov}" Style="{StaticResource NaslovSekcije}" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                    </DockPanel>

                    <Border DockPanel.Dock="Bottom" Background="{StaticResource Lcd}" CornerRadius="9" Padding="16,12" Margin="0,12,0,0"
                            Visibility="{Binding Plejer.KrajVidljiv, Converter={StaticResource Ima}}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="KRAJ" FontFamily="{StaticResource Lcd14}" FontSize="12" Foreground="{StaticResource Mutan}" Margin="0,0,10,0" />
                                <TextBlock Text="PLEJLISTE" FontFamily="{StaticResource Lcd14}" FontSize="12" Foreground="{StaticResource Mutan}" />
                            </StackPanel>
                            <p:LcdTekst x:Name="KrajLcd" Tekst="{Binding Plejer.KrajSat}" Velicina="36" Margin="0,8,0,8" HorizontalAlignment="Left" />
                            <TextBlock Text="{Binding Plejer.KrajOpis}" FontSize="12" Foreground="{StaticResource Mutan}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>

                    <DockPanel DockPanel.Dock="Bottom" Margin="6,8,6,0" Visibility="{Binding Plejer.JosOpis, Converter={StaticResource Ima}}">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding Plejer.JosTrajanje}" Foreground="{StaticResource Mutan}" FontSize="14" />
                        <TextBlock Text="{Binding Plejer.JosOpis}" FontSize="14" />
                    </DockPanel>

                    <!-- The queue is a well: songs drop into it, and the lip lights up while files are dragged over -->
                    <p:Udubljenje x:Name="RedUsek" Zaobljenje="12" Unutrasnje="10,8,10,6"
                                  Pozadina="{StaticResource DubinaPozadina}">
                        <Grid>
                            <StackPanel Margin="6,4" Visibility="{Binding Plejer.ImaRed, Converter={StaticResource Ima}, ConverterParameter=obrnuto}">
                                <TextBlock Text="Red je prazan. Klikni album na zidu, dodaj muziku dugmadima ili je prevuci u prozor iz Explorer-a." Foreground="{StaticResource Mutan}" FontSize="13"
                                           TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button Content="+ Dodaj album" Style="{StaticResource Dugme}" Padding="11,5" FontSize="12" Margin="0,0,8,0" Click="NaDodajAlbum" />
                                    <Button Content="+ Dodaj pesme" Style="{StaticResource Dugme}" Padding="11,5" FontSize="12" Click="NaDodajPesme" />
                                </StackPanel>
                            </StackPanel>
                            <ListBox x:Name="ListaSledi" Style="{StaticResource Lista}" ItemsSource="{Binding Plejer.Sledi}" SelectionMode="Extended"
                                     MouseDoubleClick="NaSlediDvoklik" KeyDown="NaSlediTaster" PreviewMouseRightButtonUp="NaSlediDesniKlik">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Height="36" ToolTip="Dupli klik pušta ovu pesmu" ToolTipService.InitialShowDelay="1500">
                                            <Button x:Name="DugmeUkloni" DockPanel.Dock="Right" Style="{StaticResource DugmeAlat}" Content="&#xE711;" Margin="4,0,-6,0"
                                                    Visibility="Collapsed" Click="NaSlediUkloni" ToolTip="Ukloni iz reda" />
                                            <TextBlock x:Name="Vreme" DockPanel.Dock="Right" Text="{Binding Trajanje}" Foreground="{StaticResource Mutan}" FontSize="14" Margin="10,0,0,0" VerticalAlignment="Center"
                                                       Typography.NumeralAlignment="Tabular" />
                                            <TextBlock x:Name="Znak" Text="&#xE768;" FontFamily="{StaticResource Ikone}" FontSize="10" VerticalAlignment="Center"
                                                       Foreground="{StaticResource Akcenat}" Margin="0,0,6,0" Visibility="Collapsed" />
                                            <TextBlock x:Name="Tekst" Text="{Binding Naslov}" FontSize="14" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        </DockPanel>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                <Setter TargetName="DugmeUkloni" Property="Visibility" Value="Visible" />
                                                <Setter TargetName="Vreme" Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Tekuca}" Value="True">
                                                <Setter TargetName="Znak" Property="Visibility" Value="Visible" />
                                                <Setter TargetName="Tekst" Property="Foreground" Value="{StaticResource Akcenat}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </p:Udubljenje>
                </DockPanel>
            </Border>

            <!-- During a day the next song is up top already, so this side shows the day ahead -->
            <Border x:Name="OstatakDana" Grid.Column="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource Linija}" BorderThickness="1,0,0,0"
                    Visibility="{Binding Dan.PrikaziOstatak, Converter={StaticResource BoolUVidljivost}}">
                <DockPanel Margin="18,22,18,18">
                    <TextBlock DockPanel.Dock="Top" Text="OSTATAK DANA" Style="{StaticResource NaslovSekcije}" Margin="0,0,0,10" />
                    <Border DockPanel.Dock="Bottom" Background="{StaticResource Lcd}" CornerRadius="9" Padding="16,12" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="KRAJ PROGRAMA" FontFamily="{StaticResource Lcd14}" FontSize="13" Foreground="{StaticResource Krem}" />
                            <p:LcdTekst Tekst="{Binding Dan.KrajPrograma}" Velicina="36" Margin="0,8,0,4" HorizontalAlignment="Left" />
                            <TextBlock Text="pa Auto DJ na Zeno.fm" FontSize="12" Foreground="{StaticResource Mutan}" />
                        </StackPanel>
                    </Border>
                    <!-- Same box as the queue: the day ahead is also a place songs go into -->
                    <p:Udubljenje Zaobljenje="12" Unutrasnje="14,10,14,8"
                                  Pozadina="{StaticResource DubinaPozadina}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                            <ItemsControl ItemsSource="{Binding Dan.Ostatak}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Height="26" Margin="2,0,2,0">
                                            <TextBlock DockPanel.Dock="Left" Text="{Binding Vreme}" Width="62" Foreground="{StaticResource Mutan}" FontSize="13" VerticalAlignment="Center"
                                                       Typography.NumeralAlignment="Tabular" />
                                            <TextBlock Text="{Binding Naziv}" Foreground="{StaticResource Tekst}" FontSize="14" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </p:Udubljenje>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ===== The song picked in the list, or the one playing ===== -->
        <Border x:Name="PanelPesme" Grid.Row="3" Height="60" Background="{StaticResource Panel}" BorderBrush="{StaticResource Linija}" BorderThickness="0,1,0,0" Padding="12,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="46" Height="46" CornerRadius="5" Background="{Binding Izabrana.Preliv}" ClipToBounds="True" Margin="0,0,12,0">
                    <Image Source="{Binding Izabrana.Omot}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Izabrana.Naslov}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Tekst}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Izabrana.Putanja}" FontSize="12" Foreground="{StaticResource Mutan}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="14,0,0,0">
                    <TextBlock Text="{Binding Izabrana.Kvalitet}" FontSize="12" Foreground="{StaticResource Mutan}" HorizontalAlignment="Right" />
                    <TextBlock Text="{Binding Izabrana.Pustano}" FontSize="12" Foreground="{StaticResource Mutan}" HorizontalAlignment="Right" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== Buttons, totals, volume ===== -->
        <Border Grid.Row="4" Background="{StaticResource Panel}" Padding="12,2,12,6">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Button x:Name="DugmePusti" Style="{StaticResource DugmeDole}" Content="&#xE768;" Command="{Binding Plejer.PustiCommand}" ToolTip="Pusti" />
                    <Button Style="{StaticResource DugmeDole}" Content="&#xE893;" Command="{Binding Plejer.SledecaCommand}" ToolTip="Sledeća" />
                    <Button x:Name="DugmePauza" Style="{StaticResource DugmeDole}" Content="&#xE769;" Command="{Binding Plejer.PauzirajCommand}" ToolTip="Pauza" />
                    <Button x:Name="DugmeStop" Style="{StaticResource DugmeDole}" Content="&#xE71A;" Click="NaStop" ToolTip="Stop" />
                    <Button x:Name="DugmePonavljanje" Style="{StaticResource DugmeDole}" Content="&#xE8EE;" Margin="16,0,5,0" Command="{Binding Plejer.PromeniPonavljanjeCommand}" />
                    <Button x:Name="DugmeMesanje" Style="{StaticResource DugmeDole}" Content="&#xE8B1;" Command="{Binding Plejer.PromeniMesanjeCommand}" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Plejer.StatusKraj}" FontSize="13" Foreground="{StaticResource Mutan}" VerticalAlignment="Center" Margin="0,0,14,0" />
                    <TextBlock Text="&#xE767;" FontFamily="{StaticResource Ikone}" FontSize="14" Foreground="{StaticResource Mutan}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <Slider Style="{StaticResource Klizac}" Minimum="0" Maximum="1" Value="{Binding Plejer.Jacina}" ToolTip="Jačina" Width="130" VerticalAlignment="Center" />
                </StackPanel>
                <Grid Margin="16,0" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" MinWidth="120" MaxWidth="560" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Plejer.StatusStavke}" FontSize="13" Foreground="{StaticResource Mutan}"
                               VerticalAlignment="Center" Margin="0,0,16,0" TextTrimming="CharacterEllipsis" />
                    <p:NivoMetar x:Name="Nivo" Grid.Column="1" Height="20" VerticalAlignment="Center"
                                 Aktivan="{Binding Plejer.Svira}"
                                 BojaUpozorenja="{StaticResource Upozorenje}"
                                 ToolTip="Nivo zvuka: zeleno do −3 dB, blagi prelaz u crveno od −3 do 0 dB" />
                </Grid>
            </DockPanel>
        </Border>

        <!-- ===== Status bar ===== -->
        <Border Grid.Row="5" Background="{StaticResource Pozadina}" BorderBrush="{StaticResource Linija}" BorderThickness="0,1,0,0" Padding="12,0">
            <DockPanel LastChildFill="False">
                <Button x:Name="DugmeVerzija" DockPanel.Dock="Right" Style="{StaticResource StavkaMenija}" Click="NaVerzije" ToolTip="Šta je novo" FontSize="12" Padding="0">
                    <TextBlock Text="{Binding Verzija}" FontSize="12" Foreground="{StaticResource Mutan}" />
                </Button>
                <Border DockPanel.Dock="Left" CornerRadius="12" Background="{Binding Plejer.PozadinaEmitovanja}"
                        BorderBrush="{Binding Plejer.IvicaEmitovanja}" BorderThickness="1" Padding="9,1,2,1"
                        VerticalAlignment="Center" HorizontalAlignment="Left" ToolTip="{Binding Plejer.OpisEmitovanja}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="8" Height="8" Fill="{Binding Plejer.BojaEmitovanja}" VerticalAlignment="Center" Margin="0,0,7,0" />
                        <TextBlock Text="{Binding Plejer.StatusEmitovanja}" FontSize="12" Foreground="{StaticResource Tekst}"
                                   VerticalAlignment="Center" Margin="0,0,7,0" />
                        <Border Width="1" Height="14" Background="{StaticResource Linija}" VerticalAlignment="Center" Margin="0,0,3,0" />
                        <Button Style="{StaticResource DugmeVeze}" Command="{Binding Plejer.UkljuciEmitovanjeCommand}"
                                Content="{Binding Plejer.NaslovEmitovanja}" ToolTip="{Binding Plejer.OpisEmitovanja}" />
                    </StackPanel>
                </Border>
            </DockPanel>
        </Border>
    </Grid>
</Window>
