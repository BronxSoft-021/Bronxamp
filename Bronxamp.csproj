<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>Bronxamp</AssemblyName>
    <ApplicationIcon>assets\app.ico</ApplicationIcon>
    <RootNamespace>Bronxamp</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <Version>0.90.74</Version>
    <Product>BronxSoft Bronxamp</Product>
    <AssemblyTitle>BronxSoft Bronxamp</AssemblyTitle>
    <Company>BronxSoft</Company>
    <Copyright>BronxSoft 2026</Copyright>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Testovi\**" />
    <Page Remove="Testovi\**" />
    <None Remove="Testovi\**" />
    <EmbeddedResource Remove="Testovi\**" />
    <Compile Remove="publish\**" />
    <None Remove="publish\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ManagedBass.Enc" Version="4.0.2" />
    <Using Include="System.IO" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="ManagedBass" Version="4.0.2" />
    <PackageReference Include="ManagedBass.Mix" Version="4.0.2" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.14" />
    <PackageReference Include="TagLibSharp" Version="2.3.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="lib\x64\*.dll" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="lib\x64\lame.exe" Link="lame.exe" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Licence.txt" CopyToOutputDirectory="PreserveNewest" />
    <Resource Include="fonts\*.ttf" />
    <Resource Include="assets\*.png" />
  </ItemGroup>

</Project>
